#!/usr/bin/env python3
import re
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LICENSE_FILE = re.compile(r"(licen[cs]e|copying|copyright|notice|unlicense)([-._].*)?", re.I)
NOTICE_FILE = re.compile(r"notice([-._].*)?", re.I)
COPYRIGHT_LINE = re.compile(r"\s*(copyright\s*(\(c\)|\u00a9|\d)|\(c\)\s*\d|\u00a9)", re.I)
LINKED = "{{with .Module}}{{if not .Main}}{{.Path}} {{.Version}} {{.Dir}}{{end}}{{end}}"
BRIDGE = "github.com/holon-sh/mcp-bridge"
RULE = "-" * 80


def modules():
    listing = subprocess.run(
        ["go", "list", "-deps", "-f", LINKED, "./cmd/holon"],
        cwd=ROOT, check=True, capture_output=True, text=True,
    ).stdout
    return sorted({tuple(line.split(" ", 2)) for line in listing.splitlines() if line})


def read_files(directory, notice):
    files = sorted(
        path for path in Path(directory).iterdir()
        if path.is_file() and path.suffix != ".go" and LICENSE_FILE.fullmatch(path.name)
        and bool(NOTICE_FILE.fullmatch(path.name)) == notice
    )
    return "\n\n".join(path.read_text(encoding="utf-8").strip() for path in files)


def split_copyright(text):
    lines = text.splitlines()
    notices = [line.strip() for line in lines if COPYRIGHT_LINE.match(line)]
    body = "\n".join(line for line in lines if not COPYRIGHT_LINE.match(line))
    return re.sub(r"\n{3,}", "\n\n", body).strip(), notices


def group(entries):
    """Collapse (name, license, notice) entries whose license text differs only in copyright lines.

    An entry with a NOTICE file is never collapsed, since Apache 2.0 requires it to travel with its module.
    """
    groups = defaultdict(list)
    for name, text, notice in entries:
        body, copyrights = split_copyright(text)
        key = (name, body) if notice else (" ".join(body.split()),)
        groups[key].append((name, body, "; ".join(copyrights), notice))
    sections = []
    for members in groups.values():
        lines = [f"{name}: {copyrights}" if copyrights else name for name, _, copyrights, _ in members]
        notice = members[0][3]
        sections.append("\n".join(lines) + "\n\n" + members[0][1] + (f"\n\n{notice}" if notice else ""))
    return sections


def module_sections():
    entries, bridge = [], None
    for path, version, directory in modules():
        text, notice = read_files(directory, False), read_files(directory, True)
        if not (text or notice):
            sys.exit(f"{path}: no license file")
        if path == BRIDGE:
            bridge = f"mcp-bridge, {path} {version}\nIts linux/amd64 and linux/arm64 binaries are embedded in holon.\n\n{text}\n\n{notice}".strip()
        else:
            entries.append((f"{path} {version}", text, notice))
    return ([bridge] if bridge else []), group(entries)


def kiln_section():
    action = (ROOT / ".github/actions/kiln/action.yml").read_text(encoding="utf-8")
    repository = re.search(r"repository: (\S+)", action)[1]
    ref = re.search(r"ref: (\S+)", action)[1]
    text = subprocess.run(
        ["curl", "-fsSL", f"https://raw.githubusercontent.com/{repository}/{ref}/LICENSE"],
        check=True, capture_output=True, text=True,
    ).stdout.strip()
    return (
        f"Kiln SDK, https://github.com/{repository} at {ref}\n"
        "Linked into holon through cgo. kiln_ocaml.opam.locked at that commit pins the opam packages it links.\n\n"
        f"{text}"
    )


def main():
    bridge, others = module_sections()
    sections = ["Third-party notices for holon, generated by scripts/third-party-notices from the modules linked into cmd/holon."]
    sections += bridge + [kiln_section()] + others
    (ROOT / "THIRD-PARTY-NOTICES").write_text(f"\n\n{RULE}\n\n".join(sections) + "\n", encoding="utf-8")


if __name__ == "__main__":
    main()
