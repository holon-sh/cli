#!/usr/bin/env python3
import re
import shutil
import subprocess
import sys
import tempfile
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LICENSE_FILE = re.compile(r"(licen[cs]e|copying|copyright|notice|unlicense)([-._].*)?", re.I)
MODULE = "{{if not .Main}}{{.Path}} {{.Version}} {{with .Replace}}{{.Dir}}{{else}}{{.Dir}}{{end}}{{end}}"
RULE = "-" * 80


def modules():
    with tempfile.TemporaryDirectory() as temporary:
        modfile = f"{temporary}/go.mod"
        shutil.copy(ROOT / "go.mod", modfile)
        shutil.copy(ROOT / "go.sum", temporary)
        subprocess.run(["go", "mod", "download", f"-modfile={modfile}", "all"], cwd=ROOT, check=True)
        listing = subprocess.run(
            ["go", "list", f"-modfile={modfile}", "-m", "-f", MODULE, "all"],
            cwd=ROOT, check=True, capture_output=True, text=True,
        ).stdout
    return [line.split(" ", 2) for line in listing.splitlines() if line]


def license_text(directory):
    files = sorted(
        path for path in Path(directory).iterdir()
        if path.is_file() and path.suffix != ".go" and LICENSE_FILE.fullmatch(path.name)
    )
    return "\n\n".join(path.read_text(encoding="utf-8").strip() for path in files)


def module_sections():
    groups = defaultdict(list)
    for path, version, directory in modules():
        text = license_text(directory)
        if not text:
            sys.exit(f"{path}: no license file")
        groups[text].append(f"{path} {version}")
    return ["\n".join(names) + "\n\n" + text for text, names in groups.items()]


def kiln_section():
    action = (ROOT / ".github/actions/kiln/action.yml").read_text(encoding="utf-8")
    repository = re.search(r"repository: (\S+)", action)[1]
    ref = re.search(r"ref: (\S+)", action)[1]
    text = subprocess.run(
        ["curl", "-fsSL", f"https://raw.githubusercontent.com/{repository}/{ref}/LICENSE"],
        check=True, capture_output=True, text=True,
    ).stdout.strip()
    return (
        f"Kiln SDK, https://github.com/{repository} at {ref}\n"
        "Linked into holon through cgo. kiln_ocaml.opam.locked at that commit pins the opam packages it links.\n\n"
        f"{text}"
    )


def main():
    sections = [
        "Third-party notices for holon, generated by scripts/third-party-notices from `go list -m all`.",
        "holon-mcp-runtime, github.com/holon-sh/runtime, MIT\n"
        "Its linux/amd64 and linux/arm64 binaries are embedded in holon. The license text is under the module below.",
        kiln_section(),
    ]
    sections += module_sections()
    (ROOT / "THIRD-PARTY-NOTICES").write_text(f"\n\n{RULE}\n\n".join(sections) + "\n", encoding="utf-8")


if __name__ == "__main__":
    main()
