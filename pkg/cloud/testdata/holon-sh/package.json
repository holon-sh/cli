{
  "name": "holon-sh",
  "version": "0.0.1",
  "description": "Declarations of the public holon-sh package for type-checking tests; protocol.d.ts inlines its @modelcontextprotocol/client types.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holon-sh/sdk-ts.git",
    "directory": "packages/node"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "holon": {
    "slot": "generated",
    "contractVersion": 1
  },
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.mjs"
    },
    "./view": {
      "types": "./view.d.ts",
      "import": "./view.js"
    },
    "./protocol": {
      "types": "./protocol.d.ts"
    }
  },
  "files": [
    "runtime.mjs",
    "runtime.d.ts",
    "validate.mjs",
    "protocol.d.ts",
    "view.js",
    "view.d.ts",
    "generated/",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
